# Copy this example to config/.env and edit that private copy only.
# Replace this placeholder with your own HTTPS Navidrome server.
NAVIDROME_URL=https://navidrome.example.com
# Supply credentials locally; never commit real login values.
NAVIDROME_USERNAME=
NAVIDROME_PASSWORD=
# Optional: set an absolute path inside your Obsidian vault to output reports there.
NYX_REPORT_DIR=
