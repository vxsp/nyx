# Credentials and machine-specific configuration; keep safe examples.
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json
config/*.local.*

# Python environments, bytecode, tests, and packaging.
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.egg-info/
build/
dist/

# Rust output. Commit Cargo.lock when generated for this application.
target/

# Private runtime output; retain only directory markers.
/state/*
!/state/.gitkeep
/logs/*
!/logs/.gitkeep
/reports/*
!/reports/.gitkeep
snapshots/
backups/
*.log
*.tmp

# Private archives, music, and FL Studio projects.
*.zip
*.7z
*.rar
*.mp3
*.flac
*.wav
*.m4a
*.aac
*.ogg
*.opus
*.aiff
*.wma
*.flp

# Native binaries and Windows/editor metadata.
*.exe
*.dll
*.pdb
*.obj
*.lib
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~
